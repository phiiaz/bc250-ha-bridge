# Copy to esphome/secrets.yaml (never commit secrets.yaml) when building locally with the ESPHome CLI:
#   cp esphome/secrets.yaml.example esphome/secrets.yaml
# If using the ESPHome Dashboard add-on in Home Assistant, it will use your existing HA secrets.yaml.

wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"
api_key: "YOUR_32_BYTE_BASE64_API_KEY"
ota_password: "YOUR_OTA_PASSWORD"
